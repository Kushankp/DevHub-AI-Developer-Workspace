<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>DevHub</string>
	<key>GitHubClientID</key>
	<string>$(GITHUB_CLIENT_ID)</string>
	<key>GitHubRedirectScheme</key>
	<string>$(GITHUB_REDIRECT_SCHEME)</string>
	<key>GitHubGraphQLURL</key>
	<string>$(GITHUB_GRAPHQL_URL)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>GitHub OAuth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GITHUB_REDIRECT_SCHEME)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
